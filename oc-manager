#!/usr/bin/env bash
#
# --- SCRIPT SIGNATURE --- #
#
#
#
#   ▄████▄    ▄█████▄            ████▄██▄   ▄█████▄  ██▄████▄   ▄█████▄   ▄███▄██   ▄████▄    ██▄████
#  ██▀  ▀██  ██▀    ▀            ██ ██ ██   ▀ ▄▄▄██  ██▀   ██   ▀ ▄▄▄██  ██▀  ▀██  ██▄▄▄▄██   ██▀
#  ██    ██  ██         █████    ██ ██ ██  ▄██▀▀▀██  ██    ██  ▄██▀▀▀██  ██    ██  ██▀▀▀▀▀▀   ██
#  ▀██▄▄██▀  ▀██▄▄▄▄█            ██ ██ ██  ██▄▄▄███  ██    ██  ██▄▄▄███  ▀██▄▄███  ▀██▄▄▄▄█   ██
#    ▀▀▀▀      ▀▀▀▀▀             ▀▀ ▀▀ ▀▀   ▀▀▀▀ ▀▀  ▀▀    ▀▀   ▀▀▀▀ ▀▀   ▄▀▀▀ ██    ▀▀▀▀▀    ▀▀
#                                                                         ▀████▀▀
#
# --- DESCRIPTION --- #
# A script for managing OpenCode web interface instances
# --- DEPENDENCIES --- #
# - opencode | opencode (opencode-bin)
# - ansifilter
# --- END SIGNATURE --- #

set -eo pipefail
trap 'exit 1' SIGUSR1

eval "$(include "lib/cmdarg.sh")"
eval "$(include "lib/helpers.sh")"
eval "$(include "check-deps")"
checkDeps "$0"

# --- cmdarg setup --- #
cmdarg_info "header" "$(get-desc "$0")"

declare -a corsDomains
cmdarg "c?[]" "corsDomains" "Additional domains to allow for CORS"
cmdarg "d?" "mdnsDomain" "custom domain name for mDNS service (default: opencode.local)"
cmdarg "m" "mdns" "enable mDNS service discovery (defaults hostname: 0.0.0.0)"
cmdarg "n?" "hostname" "Which hostname to listen on (default: 127.0.0.1)"
cmdarg "p?" "port" "Which port to listen on"
cmdarg "r" "pure" "Run without external plugins"
cmdarg "s?" "password" "Add a password to your server"
cmdarg "u?" "username" "Which username to use (default: opencode)"

cmdarg_parse "$@"
# ---  Main script logic --- #
action="${argv[0]}"
if ((argc == 0)); then
  cmdarg_usage
  exit 0
fi

# --- Store flags --- #
mdnsDomain="${cmdarg_cfg['mdnsDomain']}"
hostname="${cmdarg_cfg['hostname']}"
mdns="${cmdarg_cfg['mdns']}"
port="${cmdarg_cfg['port']}"
pure="${cmdarg_cfg['pure']}"
password="${cmdarg_cfg['password']}"
username="${cmdarg_cfg['username']}"

# --- App variables --- #
declare localUrl networkUrl PID
scriptName="${BASH_SOURCE[0]##*/}"
configDir="${XDG_CONFIG_HOME:-${HOME}/.config}/opencode"
cacheDir="${XDG_CACHE_HOME:-${HOME}/.cache}/${scriptName}"
hashFile="${cacheDir}/hash"
lockFile="${cacheDir}/lock"
logFile="${cacheDir}/log"
watchPidFile="${cacheDir}/watch"
watchLog="${cacheDir}/watch.log"

# Watch configuration: how often to poll the config file (seconds) and how
# long the config must stay unchanged before we treat the change as settled (seconds).
watchInterval=5
watchDebounce=2

# --- Helpers --- #
hashCmd=()
read -ra hashCmd <<<"$(findHasher)"
hasher() {
  local hash
  read -d' ' -r hash < <("${hashCmd[@]}" "$@")
  echo "${hash}"
}

setup() {
  if [[ -s "${configDir}/opencode.jsonc" ]]; then
    configFile="${configDir}/opencode.jsonc"
  elif [[ -s "${configDir}/opencode.json" ]]; then
    configFile="${configDir}/opencode.json"
  else
    log-warning "No config file found at ${configDir}"
    log-error "Create an opencode.json or opencode.jsonc file first."
  fi

  mkdir -p "${cacheDir}" || log-error "Failed to create cache directory: ${cacheDir}"
  touch "${hashFile}" || log-error "Failed to create the config hash file: ${hashFile}"

  return 0
}

# Store the current config hash so later runs/watchers can detect changes.
storeHash() {
  hasher "${configFile}" >"${hashFile}" || log-error "Failed to write config hash to ${hashFile}"
}

logContent() {
  if [[ -s "${logFile}" ]]; then
    ansifilter "${logFile}"
  else
    echo ""
  fi
}

isRunning() { [[ -s "${lockFile}" ]]; }

# Kill only the OpenCode server process (keeps the watcher alive across restarts).
killServer() {
  isRunning || return 0
  killwait "$(pid)" || log-error "Failed to kill OpenCode, try running 'kill-process opencode' instead."
  rm -f "${lockFile}" "${logFile}"
  return 0
}

# Spawn the background config watcher (idempotent: returns early if one is alive).
startWatcher() {
  [[ -s "${watchPidFile}" ]] && kill -0 "$(cat "${watchPidFile}")" 2>/dev/null && return 0
  nohup "${BASH_SOURCE[0]}" __watch >>"${watchLog}" 2>&1 </dev/null &
  echo "$!" >"${watchPidFile}"
}

# Hidden action: poll the config file and restart OpenCode whenever it changes.
watch() {
  local current last stable ticks
  ticks=$((watchDebounce * 5)) # 0.2s granularity
  while true; do
    sleep "${watchInterval}"
    current="$(hasher "${configFile}")"
    [[ "${current}" == "$(cat "${hashFile}")" ]] && continue

    # Config changed — wait for the editor to settle (coalesce rapid saves).
    stable=0
    last="${current}"
    while ((stable < ticks)); do
      sleep 0.2
      current="$(hasher "${configFile}")"
      if [[ "${current}" == "${last}" ]]; then
        ((++stable))
      else
        last="${current}"
        stable=0
      fi
    done

    if [[ "$(hasher "${configFile}")" != "$(cat "${hashFile}")" ]]; then
      log-info "Config file changed — restarting OpenCode"
      "${BASH_SOURCE[0]}" restart
    fi
  done
}

# --- Actions --- #
start() {
  isRunning && terminate "OpenCode is already running with pid: $(pid), check '${scriptName} status'."
  local args=(web)

  [[ -n "${port}" ]] && args+=("--port" "${port}")
  [[ -n "${hostname}" ]] && args+=("--hostname" "${hostname}")
  [[ -n "${mdnsDomain}" ]] && args+=("--mdns-domain" "${mdnsDomain}")
  "${mdns}" && args+=("--mdns")
  "${pure}" && args+=("--pure")
  (("${#corsDomains[@]}")) && args+=("--cors" "${corsDomains[@]}")

  OPENCODE_SERVER_PASSWORD="${password:-${OPENCODE_SERVER_PASSWORD}}" \
    OPENCODE_SERVER_USERNAME="${username:-${OPENCODE_SERVER_USERNAME}}" \
    opencode "${args[@]}" &>"${logFile}" &
  PID=$!

  # Wait for opencode to report the listening URLs (new format: "Web interface:",
  # old format: "Local access:" / "Network access:").
  local maxWait=15 waited=0 logOut
  while ((waited < maxWait)); do
    logOut="$(logContent)"
    localUrl="$(echo "${logOut}" | rg -i 'Web interface:|Local access:' | awk '{ print $3 }' || true)"
    networkUrl="$(echo "${logOut}" | rg -i 'Network access:' | awk '{ print $3 }' || true)"
    [[ -n "${localUrl}" ]] && break
    sleep 1
    ((++waited))
  done

  if [[ -z "${localUrl}" ]]; then
    log-error "Timeout waiting for OpenCode to start (check ${logFile})"
  fi

  printf '%d\n%s\n%s\n' "${PID}" "${localUrl}" "${networkUrl}" >"${lockFile}"

  trim "${lockFile}" &>/dev/null
  log-success "OpenCode is running at ${localUrl}${networkUrl+" and ${networkUrl}"}"

  # Remember the config we started with, then start watching it for changes.
  storeHash
  startWatcher
}

stop() {
  isRunning || terminate "OpenCode is not running!"
  killServer
  if [[ -s "${watchPidFile}" ]]; then
    killwait "$(cat "${watchPidFile}")" 2>/dev/null || true
    rm -f "${watchPidFile}"
  fi
  log-info "OpenCode stopped successfully."
}

restart() { killServer && start; }

status() {
  isRunning || terminate "OpenCode is not running!"
  local net="$(viewlines 3 "${lockFile}")"

  printBlue -n "PID: "
  pid

  printYellow -n "Local Access: "
  viewlines 2 "${lockFile}"

  printYellow -n "Network Access: "
  echo "${net:-N/A}"
}

pid() {
  isRunning || log-error "OpenCode is not running!"
  viewlines 1 "${lockFile}"
}

# Evaluate the action
setup
case "${action}" in
start) start ;;
stop) stop ;;
restart) restart ;;
status) status ;;
pid) pid ;;
__watch) watch ;;
*) cmdarg_usage && exit 1 ;;
esac
