#!/usr/bin/env bash
#
# --- SCRIPT SIGNATURE --- #
#
#
#
#   ▄████▄    ▄█████▄            ████▄██▄   ▄█████▄  ██▄████▄   ▄█████▄   ▄███▄██   ▄████▄    ██▄████
#  ██▀  ▀██  ██▀    ▀            ██ ██ ██   ▀ ▄▄▄██  ██▀   ██   ▀ ▄▄▄██  ██▀  ▀██  ██▄▄▄▄██   ██▀
#  ██    ██  ██         █████    ██ ██ ██  ▄██▀▀▀██  ██    ██  ▄██▀▀▀██  ██    ██  ██▀▀▀▀▀▀   ██
#  ▀██▄▄██▀  ▀██▄▄▄▄█            ██ ██ ██  ██▄▄▄███  ██    ██  ██▄▄▄███  ▀██▄▄███  ▀██▄▄▄▄█   ██
#    ▀▀▀▀      ▀▀▀▀▀             ▀▀ ▀▀ ▀▀   ▀▀▀▀ ▀▀  ▀▀    ▀▀   ▀▀▀▀ ▀▀   ▄▀▀▀ ██    ▀▀▀▀▀    ▀▀
#                                                                         ▀████▀▀
#
# --- DESCRIPTION --- #
# A script for managing OpenCode web interface instances
# --- DEPENDENCIES --- #
# - opencode | opencode (opencode-bin)
# - ansifilter
# - watchexec
# --- END SIGNATURE --- #

set -eo pipefail
trap 'exit 1' SIGUSR1

source "$(include "lib/cmdarg.sh")"
source "$(include "lib/helpers.sh")"
source "$(include "check-deps")"
checkDeps "$0"

# --- cmdarg setup --- #
cmdarg_info "header" "$(get-desc "$0")"

declare -a corsDomains
cmdarg "c?[]" "corsDomains" "Additional domains to allow for CORS"
cmdarg "d?" "mdnsDomain" "custom domain name for mDNS service (default: opencode.local)"
cmdarg "m" "mdns" "enable mDNS service discovery (defaults hostname: 0.0.0.0)"
cmdarg "n?" "hostname" "Which hostname to listen on (default: 127.0.0.1)"
cmdarg "p?" "port" "Which port to listen on"
cmdarg "r" "pure" "Run without external plugins"
cmdarg "s?" "password" "Add a password to your server"
cmdarg "u?" "username" "Which username to use (default: opencode)"

# --- Setup the usage function --- #
usageMsg="$(cmdarg_usage)"
unset -f 'cmdarg_usage'

cmdarg_usage() {
  echo "${usageMsg}"
  cat <<EOF

Subcommands:
    start        Start the OpenCode web interface server
    stop|kill    Stop the running server and config watcher
    restart      Restart the server (stop then start)
    status       Show PID and access URLs
    pid          Show only the server PID
EOF
  exit "${1:-0}"
}

cmdarg_parse "$@"
# ---  Main script logic --- #
action="${argv[0]}"
((argc)) || cmdarg_usage

# --- Store flags --- #
mdnsDomain="${cmdarg_cfg['mdnsDomain']}"
hostname="${cmdarg_cfg['hostname']}"
mdns="${cmdarg_cfg['mdns']}"
port="${cmdarg_cfg['port']}"
pure="${cmdarg_cfg['pure']}"
password="${cmdarg_cfg['password']}"
username="${cmdarg_cfg['username']}"

# --- App variables --- #
declare localUrl PID
declare -a networkUrls
scriptName="${BASH_SOURCE[0]##*/}"
configDir="${XDG_CONFIG_HOME:-${HOME}/.config}/opencode"
cacheDir="/tmp/${scriptName}"
lockFile="${cacheDir}/lock"
logFile="${cacheDir}/log"
watchPidFile="${cacheDir}/watch"
watchLog="${cacheDir}/watch.log"

# --- Helpers --- #

setup() {
  if ! [[ -s "${configDir}/opencode.jsonc" || -s "${configDir}/opencode.json" ]]; then
    log-warning "No config file found at ${configDir}"
    log-error "Create an opencode.json or opencode.jsonc file first."
  fi

  mkdir -p "${cacheDir}" || log-error "Failed to create cache directory: ${cacheDir}"

  return 0
}

logContent() {
  if [[ -s "${logFile}" ]]; then
    ansifilter "${logFile}"
  else
    echo ""
  fi
}

isRunning() { [[ -s "${lockFile}" ]]; }

# Kill only the OpenCode server process (keeps the watcher alive across restarts).
killServer() {
  isRunning || return 0
  killwait "$(pid)" || log-error "Failed to kill OpenCode, try running 'kill-process opencode' instead."
  rm -f "${lockFile}" "${logFile}"
  return 0
}

# Spawn the background config watcher using watchexec (idempotent).
startWatcher() {
  [[ -s "${watchPidFile}" ]] && kill -0 "$(cat "${watchPidFile}")" 2>/dev/null && return 0
  nohup watchexec \
    -w "${configDir}" \
    -f "opencode.json" \
    -f "opencode.jsonc" \
    -d 5s \
    -p \
    -r \
    -- "${BASH_SOURCE[0]}" __watch \
    >>"${watchLog}" 2>&1 </dev/null &
  echo "$!" >"${watchPidFile}"
}

# Hidden action: restart OpenCode (called by watchexec on config changes).
watch() {
  log-info "Config file changed — restarting OpenCode"
  restart
}

# --- Actions --- #
start() {
  isRunning && terminate "OpenCode is already running with pid: $(pid), check '${scriptName} status'."
  local args=(web)

  [[ -n "${port}" ]] && args+=("--port" "${port}")
  [[ -n "${hostname}" ]] && args+=("--hostname" "${hostname}")
  [[ -n "${mdnsDomain}" ]] && args+=("--mdns-domain" "${mdnsDomain}")
  "${mdns}" && args+=("--mdns")
  "${pure}" && args+=("--pure")
  (("${#corsDomains[@]}")) && args+=("--cors" "${corsDomains[@]}")

  OPENCODE_SERVER_PASSWORD="${password:-${OPENCODE_SERVER_PASSWORD}}" \
    OPENCODE_SERVER_USERNAME="${username:-${OPENCODE_SERVER_USERNAME}}" \
    opencode "${args[@]}" &>"${logFile}" &
  PID=$!

  # Wait for opencode to report the listening URLs
  # new format: "Web interface:", old format: "Local access:" / "Network access:".
  local maxWait=15 waited=0
  while ((waited < maxWait)); do
    localUrl="$(logContent | rg -i 'Web interface:|Local access:' | awk '{ print $3 }' || true)"
    mapfile -t networkUrls < <(logContent | rg -i 'Network access:' | awk '{ print $3 }' || true)
    [[ -n "${localUrl}" ]] && break
    sleep 1
    ((++waited))
  done

  if [[ -z "${localUrl}" ]]; then
    log-error "Timeout waiting for OpenCode to start (check ${logFile})"
  fi

  # Write lock file: PID, localUrl, then networkUrls (one per line)
  {
    printf '%d\n' "${PID}"
    printf '%s\n' "${localUrl}"
    printf '%s\n' "${networkUrls[@]}"
  } >"${lockFile}"

  trim "${lockFile}" &>/dev/null

  # Build success message
  local msg="OpenCode is running at $(printCyan -n "${localUrl}")"
  local prefix len="${#networkUrls[@]}"
  for ((i = 0; i < len; ++i)); do
    prefix=","
    ((i == len - 1)) && prefix=", and"

    msg+="${prefix} $(printCyan -n "${networkUrls[${i}]}")"
  done
  log-success "${msg}"

  # Start watching config for changes.
  startWatcher
}

stop() {
  isRunning || terminate "OpenCode is not running!"
  killServer
  if [[ -s "${watchPidFile}" ]]; then
    killwait "$(cat "${watchPidFile}")" 2>/dev/null || true
    rm -f "${watchPidFile}"
  fi
  log-info "OpenCode stopped successfully."
}

restart() { killServer && start; }

status() {
  isRunning || terminate "OpenCode is not running!"

  printBlue -n "PID: "
  pid

  printYellow -n "Local Access: "
  viewlines 2 "${lockFile}"

  local -a net
  mapfile -t net < <(tail -n +3 "${lockFile}")
  if ((${#net[@]})); then
    local ip
    for ip in "${net[@]}"; do
      printYellow -n "Network Access: "
      printf '%s\n' "${ip}"
    done
  else
    printYellow -n "Network Access: "
    echo "N/A"
  fi
}

pid() {
  isRunning || log-error "OpenCode is not running!"
  viewlines 1 "${lockFile}"
}

# Evaluate the action
setup
case "${action}" in
start) start ;;
stop | kill) stop ;;
restart) restart ;;
status) status ;;
pid) pid ;;
__watch) watch ;;
? | *) cmdarg_usage 1 ;;
esac
