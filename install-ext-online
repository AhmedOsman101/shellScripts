#
#
# --- DESCRIPTION --- #
# Installs VS Code extensions from a JSON file by combining with online extensions
# Origin can be a JSON file, or one of: disabled, enabled, all
# --- DEPENDENCIES --- #
# - code
# - jq
# - gum
# - sqlite3
# --- END SIGNATURE --- #

set -eo pipefail
trap 'exit 1' SIGUSR1

source "$(include "lib/cmdarg.sh")"
source "$(include "check-deps")"
source "$(include "lib/vscode.sh")"

checkDeps "$0"
cmdarg_info "header" "$(get-desc "$0")"
declare -a selectedExtensions
cmdarg "e?[]" "selectedExtensions" "Choose predefined set of extensions"
cmdarg "i" "interactive" "Interactively choose which extensions to install"
cmdarg "t?" "tries" "Maximum number of install attempts per extension"

# --- Setup the usage function --- #
# shellcheck disable=2218
usageMsg="$(cmdarg_usage)"
unset -f 'cmdarg_usage'

cmdarg_usage() {
  echo "${usageMsg}"
  cat <<EOF

Positional Arguments:
    origin       Extensions source: JSON file path or one of: disabled, enabled, all (default: all)
EOF
  exit "${2:-0}"
}

cmdarg_parse "$@"

# ---  Main script logic --- #
origin="${argv[0]:-all}"
interactive="${cmdarg_cfg['interactive']}"
tries="${cmdarg_cfg['tries']}"
if [[ -n "${tries}" ]]; then
  isPositiveInt "${tries}" || log-error "Tries must be a positive integer"
fi

file="$(mktemp -t "XXXXXX.json")"
trap 'rm -f $file' EXIT

# Origin is either a JSON file or a keyword: disabled, enabled, all
originFile="${origin}"
if ! [[ -f "${origin}" ]]; then
  originFile="$(mktemp -t "XXXXXX.json")"
  trap 'rm -f $file $originFile' EXIT
  case "${origin}" in
  disabled) disabledExtensions ;;
  enabled) enabledExtensions ;;
  all) allExtensions ;;
  *) terminate "Invalid origin '${origin}', must be a file or one of: disabled, enabled, all" ;;
  esac | jq -R . | jq -s . >"${originFile}" || log-error "Failed to resolve origin '${origin}'"
fi

get-ext --overwrite "${file}" &>/dev/null

# NOTE: Returns True if file exists and is not empty.
if ! [[ -s "${originFile}" ]]; then
  terminate "No entries found in ${origin}"
fi

declare -a extensions
if [[ -s "${file}" ]]; then
  # Combine JSON files with only unique enteries as an array
  mapfile -t extensions < <(jq -s '[.[][]] | unique | .[]' -r "${originFile}" "${file}") || log-error "Failed to parse '${file}'"
  ((${#extensions[@]})) || terminate "No extensions matched '${origin}'"
else
  terminate "No new entries found in ${file}"
fi

# Interactive selection of which extensions to install
if "${interactive}"; then
  cmd=(
    'gum'
    'choose'
    '--select-if-one'
    '--no-limit'
    '--header="Select extensions to install:"'
  )
  if ((${#selectedExtensions[@]})); then
    cmd+=("--selected='$(joinarr ',' "${selectedExtensions[@]}")'")
  fi

  selected="$("${cmd[@]}" "${extensions[@]}")" || terminate "Selection cancelled."
  [[ -z "${selected}" ]] && terminate "No extensions selected."
  unset selectedExtensions
  mapfile -t selectedExtensions <<<"${selected}"
elif ! ((${#selectedExtensions[@]})); then
  selectedExtensions=("${extensions[@]}")
fi

for extension in "${selectedExtensions[@]}"; do
  extensionName="$(awk -F '.' '{print $2}' <<<"${extension}")"

  log-info "Installing ${extensionName}..."
  if repeat-it ${tries:+--tries "${tries}"} --preserve "code --install-extension ${extension} --force"; then
    log-success "Installed ${extensionName}"
  fi
done

log-success "Installation Done 🚀"
