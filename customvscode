#!/usr/bin/env bash

if command -v code &>/dev/null; then
  sudo chown -R "$(whoami)" "$(command -v code)" 2>/dev/null
  sudo chown -R "$(whoami)" /opt/visual-studio-code 2>/dev/null
  sudo chown -R "$(whoami)" /usr/share/code 2>/dev/null
fi

if command -v cursor &>/dev/null; then
  sudo chown -R "$(whoami)" "$(command -v cursor)" 2>/dev/null
  sudo chown -R "$(whoami)" /opt/cursor 2>/dev/null
  sudo chown -R "$(whoami)" /usr/lib/cursor 2>/dev/null
fi

if command -v antigravity-ide &>/dev/null; then
  sudo chown -R "$(whoami)" "$(command -v antigravity-ide)" 2>/dev/null
  sudo chown -R "$(whoami)" /opt/antigravity-ide 2>/dev/null
  sudo chown -R "$(whoami)" /usr/lib/antigravity-ide 2>/dev/null
fi

exit 0
