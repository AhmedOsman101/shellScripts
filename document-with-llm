# set -eo pipefail
trap 'exit 1' SIGUSR1
SCRIPTS_DIR="${SCRIPTS_DIR:-${HOME}/scripts}"

source "$(include "lib/cmdarg.sh")"
source "$(include "lib/helpers.sh")"
source "$(include "check-deps")"
checkDeps "$0"

# --- cmdarg setup --- #
cmdarg_info "header" "$(get-desc "$0")"
cmdarg "d?" "dir" "Wiki directory" "${SCRIPTS_DIR}/wiki"
cmdarg "p?" "provider" "LLM provider (opencode, pi, claude)" "pi"
cmdarg "m?" "model" "LLM model to use"
cmdarg "f" "force" "Overwrite existing pages"
cmdarg "v" "verbose" "Enable verbose output"
cmdarg_parse "$@"

# --- Config --- #
WIKI_DIR="${cmdarg_cfg['dir']}"
PROVIDER="${cmdarg_cfg['provider']}"
MODEL="${cmdarg_cfg['model']}"
FORCE="${cmdarg_cfg['force']}"
VERBOSE="${cmdarg_cfg['verbose']}"

scriptName="${BASH_SOURCE[0]##*/}"
cacheDir="${XDG_CACHE_HOME:-${HOME}/.cache}/${scriptName}"
mkdir -p "${cacheDir}"

logVerbose() {
  "${VERBOSE}" && logInfo "$1"
}

# --- Prompt --- #
prompt() {
  cat "${SCRIPTS_DIR}/templates/document-with-llm/prompt.md"
}

# --- Functions --- #

# Get project directories for a language
getProjects() {
  local lang="$1"
  case "${lang}" in
  typescript)
    # TypeScript projects are directories under typescript/
    find "${SCRIPTS_DIR}/typescript" -mindepth 1 -maxdepth 1 -type d ! -name '.*' 2>/dev/null
    ;;
  python)
    # Python projects are directories under python/
    find "${SCRIPTS_DIR}/python" -mindepth 1 -maxdepth 1 -type d ! -name '.*' 2>/dev/null
    ;;
  c)
    # C files are individual .c files in c/
    find "${SCRIPTS_DIR}/c" -maxdepth 1 -name "*.c" -type f 2>/dev/null
    ;;
  cpp)
    # C++ files are individual .cpp files in cpp/
    find "${SCRIPTS_DIR}/cpp" -maxdepth 1 -name "*.cpp" -type f 2>/dev/null
    ;;
  lua)
    # Lua files are individual .lua files in lua/
    find "${SCRIPTS_DIR}/lua" -maxdepth 1 -name "*.lua" -type f 2>/dev/null
    ;;
  *) : ;;
  esac
}

# Get project name from path
getProjectName() {
  local path="$1"
  basename "${path}"
}

# Get wiki subdirectory for language
getWikiDir() {
  local lang="$1"
  case "${lang}" in
  typescript | c | cpp | python | lua) echo "${lang}" ;;
  *) echo "" ;;
  esac
}

# Collect project context for LLM
collectContext() {
  local project_path="$1"
  local lang="$2"
  local context=""

  context+="## Project Structure"
  context+=$'\n\n'

  case "${lang}" in
  typescript)
    context+="$(find "${project_path}" -maxdepth 1 -type f | sed "s|${project_path}/||" | sort | sed 's/^/- /')"
    context+=$'\n\n'

    if [[ -f "${project_path}/deno.json" ]]; then
      context+="## deno.json"
      context+=$'\n\n'
      context+='```json'
      context+=$'\n'
      context+="$(cat "${project_path}/deno.json")"
      context+=$'\n''```'
      context+=$'\n\n'
    fi

    local ts_file
    ts_file=$(find "${project_path}" -maxdepth 1 -name "*.ts" -type f | head -1)
    if [[ -n "${ts_file}" ]]; then
      context+="## $(basename "${ts_file}")"
      context+=$'\n\n'
      context+='```typescript'
      context+=$'\n'
      context+="$(cat "${ts_file}")"
      context+=$'\n''```'
      context+=$'\n\n'
    fi
    ;;
  python)
    context+="$(find "${project_path}" -maxdepth 1 -type f | sed "s|${project_path}/||" | sort | sed 's/^/- /')"
    context+=$'\n\n'

    if [[ -f "${project_path}/main.py" ]]; then
      context+="## main.py"
      context+=$'\n\n'
      context+='```python'
      context+=$'\n'
      context+="$(cat "${project_path}/main.py")"
      context+=$'\n''```'
      context+=$'\n\n'
    fi
    ;;
  c | cpp)
    local src_file="${project_path}"
    context+="## $(basename "${src_file}")"
    context+=$'\n\n'
    context+="\`\`\`${lang}"
    context+=$'\n'
    context+="$(cat "${src_file}")"
    context+=$'\n''```'
    context+=$'\n\n'
    ;;
  lua)
    context+="## $(basename "${project_path}")"
    context+=$'\n\n'
    context+='```lua'
    context+=$'\n'
    context+="$(cat "${project_path}")"
    context+=$'\n''```'
    context+=$'\n\n'
    ;;
  *) : ;;
  esac

  printf '%s' "${context}"
}

# Compute a content hash for a project (all files for dirs, single file otherwise)
projectHash() {
  local project_path="$1"
  local -a files

  if [[ -d "${project_path}" ]]; then
    # fd.sh excludes noise (node_modules, dist, .git, ...)
    mapfile -t files < <(fd.sh . "${project_path}" --type f | sort)
  else
    files=("${project_path}")
  fi

  local -a hasher
  read -ra hasher <<<"$(findHasher)"
  cat "${files[@]}" 2>/dev/null | "${hasher[@]}" | awk '{print $1}'
}

# Generate wiki page using LLM
generateWithLLM() {
  local project_path="$1"
  local lang="$2"

  local project_name wiki_dir output_file
  project_name=$(getProjectName "${project_path}")
  wiki_dir=$(getWikiDir "${lang}")

  # For TypeScript/Python, project_name is the dir name
  # For C/C++/Lua, project_name is the filename without extension
  if [[ "${lang}" == "c" ]]; then
    project_name="${project_name%.c}"
  elif [[ "${lang}" == "cpp" ]]; then
    project_name="${project_name%.cpp}"
  elif [[ "${lang}" == "lua" ]]; then
    project_name="${project_name%.lua}"
  fi

  output_file="${WIKI_DIR}/${wiki_dir}/${project_name}.md"

  # Change-detection cache: skip if the page exists and the project hasn't changed
  local hash cache_file
  hash="$(projectHash "${project_path}")"
  cache_file="${cacheDir}/${lang}-${project_name}.hash"
  if [[ -f "${output_file}" ]] && [[ -f "${cache_file}" ]] && [[ "$(<"${cache_file}")" == "${hash}" ]] && ! "${FORCE}"; then
    logVerbose "Skipping ${project_name} (unchanged)"
    return 0
  fi

  # Skip if exists and not forced
  if [[ -f "${output_file}" ]] && ! "${FORCE}"; then
    logVerbose "Skipping ${project_name} (exists)"
    return 0
  fi

  mkdir -p "$(dirname "${output_file}")"

  logInfo "Documenting: ${project_name}"

  local context
  context=$(collectContext "${project_path}" "${lang}")

  # Build the full prompt
  full_prompt() {
    prompt
    cat <<PROMPT

## PROJECT OUTPUT FILE
Write the documentation to: ${output_file}

## PROJECT PATH

${lang}/${project_name}/

## PROJECT CONTEXT

${context}

Generate the wiki page now.
PROMPT
  }

  logInfo "Opening ${PROVIDER} for: ${project_name}"

  # Providers expect a directory, but C/C++/Lua projects are single files
  local run_dir="${project_path}"
  [[ -d "${run_dir}" ]] || run_dir="$(dirname "${run_dir}")"

  # Execute based on provider
  case "${PROVIDER}" in
  opencode)
    opencode --prompt "$(full_prompt)" ${MODEL:+--model "${MODEL}"} "${run_dir}"
    ;;
  pi)
    cd "${run_dir}" || exit
    pi ${MODEL:+--model "${MODEL}"} "$(full_prompt)"
    ;;
  claude)
    cd "${run_dir}" || exit
    if [[ -n "${MODEL}" ]]; then
      ANTHROPIC_DEFAULT_FABLE_MODEL="${MODEL:-}" \
        ANTHROPIC_DEFAULT_OPUS_MODEL="${MODEL:-}" \
        ANTHROPIC_DEFAULT_SONNET_MODEL="${MODEL:-}" \
        ANTHROPIC_DEFAULT_HAIKU_MODEL="${MODEL:-}" \
        claude --model "opus" "$(full_prompt)"
    else
      claude "$(full_prompt)"
    fi
    ;;
  *) log-error --no-kill "Unknown provider: ${PROVIDER}" ;;
  esac

  logSuccess "Documentation session complete for: ${project_name}"

  # Record the hash so unchanged projects are skipped next run
  printf '%s\n' "${hash}" >"${cache_file}"
}

# --- Main --- #

# Supported languages
LANGUAGES=(c cpp python typescript lua)

total=0

for lang in "${LANGUAGES[@]}"; do
  unset projects &>/dev/null || true
  mapfile -t projects < <(getProjects "${lang}")
  ((${#projects[@]})) || continue

  for project in "${projects[@]}"; do
    [[ -e "${project}" ]] || continue
    ((++total))
    generateWithLLM "${project}" "${lang}"
  done
done

echo ""
logSuccess "LLM documentation sessions complete!"
echo "  Total projects: ${total}"
echo ""
echo "The prompt files have been generated. Review them and let the LLM generate documentation."
