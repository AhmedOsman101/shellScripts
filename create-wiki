#!/usr/bin/env bash
# shellcheck disable=2016
# --- SCRIPT SIGNATURE --- #
#
#
#                                                                                     ██     ▄▄           ██
#                                            ██                                       ▀▀     ██           ▀▀
#   ▄█████▄   ██▄████   ▄████▄    ▄█████▄  ███████    ▄████▄            ██      ██  ████     ██ ▄██▀    ████
#  ██▀    ▀   ██▀      ██▄▄▄▄██   ▀ ▄▄▄██    ██      ██▄▄▄▄██           ▀█  ██  █▀    ██     ██▄██        ██
#  ██         ██       ██▀▀▀▀▀▀  ▄██▀▀▀██    ██      ██▀▀▀▀▀▀   █████    ██▄██▄██     ██     ██▀██▄       ██
#  ▀██▄▄▄▄█   ██       ▀██▄▄▄▄█  ██▄▄▄███    ██▄▄▄   ▀██▄▄▄▄█            ▀██  ██▀  ▄▄▄██▄▄▄  ██  ▀█▄   ▄▄▄██▄▄▄
#    ▀▀▀▀▀    ▀▀         ▀▀▀▀▀    ▀▀▀▀ ▀▀     ▀▀▀▀     ▀▀▀▀▀              ▀▀  ▀▀   ▀▀▀▀▀▀▀▀  ▀▀   ▀▀▀  ▀▀▀▀▀▀▀▀
#
# --- DESCRIPTION --- #
# Generates wiki pages for all scripts in the repository
# --- DEPENDENCIES --- #
#
# --- END SIGNATURE --- #

set -eo pipefail
trap 'exit 1' SIGUSR1

source "$(include "lib/cmdarg.sh")"
source "$(include "lib/helpers.sh")"
source "$(include "check-deps")"
checkDeps "$0"

# --- cmdarg setup --- #
cmdarg_info "header" "$(get-desc "$0")"
cmdarg "d?" "dir" "Wiki directory" "${SCRIPTS_DIR}/wiki"
cmdarg "f" "force" "Overwrite existing pages"
cmdarg "a" "all" "Also generate pages for non-bash scripts using LLM"
cmdarg "p?" "provider" "LLM provider (opencode, pi, claude)" "pi"
cmdarg "m?" "model" "LLM model to use"
cmdarg "v" "verbose" "Enable verbose output"
cmdarg_parse "$@"

# --- Config --- #
WIKI_DIR="${cmdarg_cfg['dir']}"
FORCE="${cmdarg_cfg['force']}"
ALL="${cmdarg_cfg['all']}"
PROVIDER="${cmdarg_cfg['provider']}"
MODEL="${cmdarg_cfg['model']}"
VERBOSE="${cmdarg_cfg['verbose']}"
SCRIPTS_DIR="${SCRIPTS_DIR:-${HOME}/scripts}"

# Scripts to exclude from wiki generation
IGNORED_SCRIPTS=(
  askpass
  echopass
  rustbook
  spin.sh
)

# Get repo URL from git remote
remote="$(git -C "${SCRIPTS_DIR}" remote get-url origin | sed 's|\.git$||')"
REPO_URL="${remote/git@github.com:/https://github.com/}"

# --- Helper Functions --- #

logVerbose() {
  "${VERBOSE}" && logInfo "$@" || true
}

# Check if script uses cmdarg
usesCmdarg() {
  grep -q 'cmdarg_parse\|cmdarg "' "$1"
}

# Get help output if script uses cmdarg (safe to run --help)
getHelpOutput() {
  local file="$1"
  # Only run --help on scripts that use cmdarg (safe help handler)
  if ! usesCmdarg "${file}"; then
    echo ""
    return
  fi

  local help_output
  help_output=$(timeout 2 "${file}" --help 2>&1 || true)

  if [[ "${help_output}" == *"--"* ]] || [[ "${help_output}" == *"Arguments"* ]]; then
    echo "${help_output}"
  else
    echo ""
  fi
}

# Parse cmdarg flags from script
parseCmdargFlags() {
  local file="$1"
  while IFS= read -r line; do
    local flag longopt desc_text
    # Extract values using sed with simple patterns
    flag=$(echo "${line}" | sed 's/.*cmdarg "\([^"]*\)".*/\1/' | head -1)
    longopt=$(echo "${line}" | sed 's/.*cmdarg "[^"]*" "\([^"]*\)".*/\1/' | head -1)
    desc_text=$(echo "${line}" | sed 's/.*cmdarg "[^"]*" "[^"]*" "\([^"]*\)".*/\1/' | head -1)

    if [[ -n "${flag}" ]]; then
      local flag_type="String"
      if [[ "${flag}" != *":"* ]] && [[ "${flag}" != *"?"* ]]; then
        flag_type="Boolean"
      elif [[ "${flag}" == *"[]"* ]]; then
        flag_type="Array"
      elif [[ "${flag}" == *"{}"* ]]; then
        flag_type="Hash Map"
      fi
      echo "| -${flag%%:*} | --${longopt} | ${flag_type} | ${desc_text:-No description} |"
    fi
  done < <(grep -E '^\s*cmdarg\s+"' "${file}")
}

# Generate wiki page for a script
generateScriptPage() {
  local file="$1"
  local script_name output_file rel_dir
  script_name=$(basename "${file}")

  # Determine relative directory
  local orig_rel_dir
  orig_rel_dir=$(dirname "${file}" | sed -e "s|^${SCRIPTS_DIR}||" -e " s|^/||")
  rel_dir="${orig_rel_dir}"
  case "${rel_dir}" in
  "") rel_dir="bash" ;;
  # Bash scripts: lib -> bash/lib/, rofi -> bash/rofi/, external -> bash/external/
  lib | rofi | external) rel_dir="bash/${rel_dir}" ;;
  # Other languages keep their dir: wiki/c/, wiki/cpp/, etc.
  *) : ;;
  esac

  mkdir -p "${WIKI_DIR}/${rel_dir}"
  output_file="${WIKI_DIR}/${rel_dir}/${script_name}.md"

  if [[ -f "${output_file}" ]] && ! "${FORCE}"; then
    logVerbose "Skipping ${script_name} (exists, use -f to overwrite)"
    return 0
  fi

  logVerbose "Generating page for ${script_name}..."

  local desc deps help_output
  desc="$(get-desc "${file}" | tr '\n' ' ' | sed -e 's/  */ /g' -e 's/^ //' -e 's/ $//')"
  deps="$(get-deps "${file}")"
  help_output=$(getHelpOutput "${file}")

  {
    echo "# ${script_name}"
    echo ""
    echo "## Description"
    echo ""
    if [[ -n "${desc}" ]]; then
      echo "${desc}"
    else
      echo "*No description available.*"
    fi
    echo ""
    echo "## Usage"
    echo ""
    echo '```bash'
    if [[ -n "${help_output}" ]]; then
      echo "${help_output}"
    else
      echo "${script_name} [options] [arguments]"
    fi
    echo '```'
    echo ""

    # Document flags if script uses cmdarg
    if usesCmdarg "${file}"; then
      flags_table=$(parseCmdargFlags "${file}")
      if [[ -n "${flags_table}" ]]; then
        echo "## Flags & Options"
        echo ""
        echo "| Short | Long | Type | Description |"
        echo "|-------|------|------|-------------|"
        echo "${flags_table}"
        echo ""
      fi
    fi

    # Positional arguments
    if grep -q 'argv\[' "${file}" || grep -q 'argc' "${file}"; then
      echo "## Positional Arguments"
      echo ""
      echo "This script accepts positional arguments after \`--\`."
      echo ""
    fi

    # Dependencies
    echo "## Dependencies"
    echo ""
    if [[ -z "${deps}" ]] || [[ "${deps}" == "x-none" ]]; then
      echo "No external dependencies."
    else
      echo "${deps}" | while IFS= read -r dep; do echo "- ${dep}"; done
    fi
    echo ""

    echo "## Source"
    echo ""
    local source_path="${orig_rel_dir:+${orig_rel_dir}/}${script_name}"
    echo "[${script_name}](${REPO_URL}/blob/main/${source_path})"
    echo ""

  } >"${output_file}"

  logSuccess "Created: ${rel_dir}/${script_name}.md"
}

# Generate wiki page for a library
generateLibPage() {
  local file="$1"
  local lib_name output_file
  lib_name=$(basename "${file}" .sh)

  mkdir -p "${WIKI_DIR}/bash/lib"
  output_file="${WIKI_DIR}/bash/lib/${lib_name}.md"

  if [[ -f "${output_file}" ]] && ! "${FORCE}"; then
    logVerbose "Skipping lib/${lib_name} (exists, use -f to overwrite)"
    return 0
  fi

  logVerbose "Generating page for lib/${lib_name}..."

  local desc
  desc="$(get-desc "${file}" | tr '\n' ' ' | sed -e 's/  */ /g' -e 's/^ //' -e' s/ $//')"

  {
    echo "# lib/${lib_name}"
    echo ""
    echo "## Description"
    echo ""
    if [[ -n "${desc}" ]]; then
      echo "${desc}"
    else
      echo "*No description available.*"
    fi
    echo ""
    echo "## Usage"
    echo ""
    echo "Include this library in your script:"
    echo ""
    echo '```bash'
    # shellcheck disable=SC2016
    echo 'source "$(include "lib/'"${lib_name}"'.sh")"'
    echo '```'
    echo ""
    echo "## Source"
    echo ""
    echo "[lib/${lib_name}.sh](${REPO_URL}/blob/main/lib/${lib_name}.sh)"
    echo ""
  } >"${output_file}"

  logSuccess "Created: bash/lib/${lib_name}.md"
}

# --- Main --- #

mkdir -p "${WIKI_DIR}/bash"

total=0
created=0
skipped=0
ignored=false

# Find all bash scripts (root + lib + rofi + external)
for file in "${SCRIPTS_DIR}"/* "${SCRIPTS_DIR}/lib"/*.sh "${SCRIPTS_DIR}/rofi"/* "${SCRIPTS_DIR}/external"/*; do
  [[ -f "${file}" ]] || continue

  # Skip non-script files
  [[ "${file}" == *.rasi ]] && continue

  first_line=$(head -1 "${file}" 2>/dev/null || true)
  if [[ "${first_line}" != *"bash"* ]] && [[ "${first_line}" != *"#!/bin/bash"* ]]; then
    continue
  fi

  script_name=$(basename "${file}")

  # Skip ignored scripts
  ignored=false
  for ignored_script in "${IGNORED_SCRIPTS[@]}"; do
    if [[ "${script_name}" == "${ignored_script}" ]]; then
      ignored=true
      break
    fi
  done
  if "${ignored}"; then
    ((++skipped))
    logVerbose "Skipping ${script_name} (ignored)"
    continue
  fi

  # Generate page based on file location
  if [[ "${file}" == *"/lib/"* ]]; then
    generateLibPage "${file}"
  else
    generateScriptPage "${file}"
  fi
  ((++created))
done

# Generate Home.md
home_file="${WIKI_DIR}/Home.md"
if [[ ! -f "${home_file}" ]] || "${FORCE}"; then
  {
    echo "# Scripts Wiki"
    echo ""
    echo "Welcome to the Scripts Wiki. This wiki documents all bash scripts in the repository."
    echo ""
    echo "## Quick Links"
    echo ""
    echo "- [Libraries](#libraries)"
    echo "- [Scripts](#scripts)"
    echo ""
    echo "## Libraries"
    echo ""
    echo "| Library | Description |"
    echo "|---------|-------------|"
    # Libraries
    for file in "${SCRIPTS_DIR}/lib"/*.sh; do
      [[ -f "${file}" ]] || continue
      lib_name=$(basename "${file}" .sh)
      desc=$(get-desc "${file}" | tr '\n' ' ' | sed -e 's/  */ /g' -e 's/^ //' -e 's/ $//')
      echo "| [lib/${lib_name}](bash/lib/${lib_name}.md) | ${desc:-No description} |"
    done
    echo ""
    echo "## Scripts"
    echo ""
    echo "| Script | Description |"
    echo "|--------|-------------|"
    # Bash scripts from root
    for file in "${SCRIPTS_DIR}"/*; do
      [[ -f "${file}" ]] || continue
      first_line=$(head -1 "${file}" 2>/dev/null || true)
      if [[ "${first_line}" == *"bash"* ]] || [[ "${first_line}" == *"#!/bin/bash"* ]]; then
        script_name=$(basename "${file}")
        desc=$(get-desc "${file}" | tr '\n' ' ' | sed -e 's/  */ /g' -e 's/^ //' -e 's/ $//')
        echo "| [${script_name}](bash/${script_name}.md) | ${desc:-No description} |"
      fi
    done
    echo ""
  } >"${home_file}"
  logSuccess "Created: Home.md"
fi

# Generate pages for non-bash scripts using LLM
if "${ALL}"; then
  document-with-llm -d "${WIKI_DIR}" -p "${PROVIDER}" ${MODEL:+-m "${MODEL}"} ${FORCE:+-f} ${VERBOSE:+-v}
fi

mdfmt "${WIKI_DIR}" &>/dev/null

echo ""
logSuccess "Wiki generation complete!"
echo "  Total scripts: ${total}"
echo "  Created: ${created}"
echo "  Skipped: ${skipped}"
echo ""
echo "Wiki location: ${WIKI_DIR}"
