#!/usr/bin/env bash
# shellcheck disable=2016
# --- SCRIPT SIGNATURE --- #
#
#
#                                                                                     ██     ▄▄           ██
#                                            ██                                       ▀▀     ██           ▀▀
#   ▄█████▄   ██▄████   ▄████▄    ▄█████▄  ███████    ▄████▄            ██      ██  ████     ██ ▄██▀    ████
#  ██▀    ▀   ██▀      ██▄▄▄▄██   ▀ ▄▄▄██    ██      ██▄▄▄▄██           ▀█  ██  █▀    ██     ██▄██        ██
#  ██         ██       ██▀▀▀▀▀▀  ▄██▀▀▀██    ██      ██▀▀▀▀▀▀   █████    ██▄██▄██     ██     ██▀██▄       ██
#  ▀██▄▄▄▄█   ██       ▀██▄▄▄▄█  ██▄▄▄███    ██▄▄▄   ▀██▄▄▄▄█            ▀██  ██▀  ▄▄▄██▄▄▄  ██  ▀█▄   ▄▄▄██▄▄▄
#    ▀▀▀▀▀    ▀▀         ▀▀▀▀▀    ▀▀▀▀ ▀▀     ▀▀▀▀     ▀▀▀▀▀              ▀▀  ▀▀   ▀▀▀▀▀▀▀▀  ▀▀   ▀▀▀  ▀▀▀▀▀▀▀▀
#
# --- DESCRIPTION --- #
# Generates wiki pages for all scripts in the repository
# --- DEPENDENCIES --- #
# - parallel
# --- END SIGNATURE --- #

set -eo pipefail
trap 'exit 1' SIGUSR1

source "$(include "lib/cmdarg.sh")"
source "$(include "lib/helpers.sh")"
source "$(include "check-deps")"
checkDeps "$0"

# --- cmdarg setup --- #
cmdarg_info "header" "$(get-desc "$0")"
cmdarg "d?" "dir" "Wiki directory" "${SCRIPTS_DIR}/wiki"
cmdarg "f" "force" "Overwrite existing pages"
cmdarg "a" "all" "Also generate pages for non-bash scripts using LLM"
cmdarg "p?" "provider" "LLM provider (opencode, pi, claude)" "pi"
cmdarg "m?" "model" "LLM model to use"
cmdarg "v" "verbose" "Enable verbose output"
cmdarg "j?" "jobs" "How many threads to use in parallel?" "$(nproc)"
cmdarg_parse "$@"

# --- Config --- #
WIKI_DIR="${cmdarg_cfg['dir']}"
FORCE="${cmdarg_cfg['force']}"
ALL="${cmdarg_cfg['all']}"
PROVIDER="${cmdarg_cfg['provider']}"
MODEL="${cmdarg_cfg['model']}"
VERBOSE="${cmdarg_cfg['verbose']}"
SCRIPTS_DIR="${SCRIPTS_DIR:-${HOME}/scripts}"
JOBS="${cmdarg_cfg['jobs']}"
isPositive "${JOBS}" || log-error "Number of threads must be positive"

# Scripts to exclude from wiki generation
IGNORED_SCRIPTS=(
  askpass
  echopass
  rustbook
  spin.sh
)

# Get repo URL from git remote
remote="$(git -C "${SCRIPTS_DIR}" remote get-url origin | sed 's|\.git$||')"
REPO_URL="${remote/git@github.com:/https://github.com/}"

# --- Helper Functions --- #

logVerbose() {
  "${VERBOSE}" && log-info "$@" || true
}

# Check if script uses cmdarg
usesCmdarg() {
  grep -q 'cmdarg_parse\|cmdarg "' "$1"
}

# Get help output if script uses cmdarg (safe to run --help)
getHelpOutput() {
  local file="$1"
  # Only run --help on scripts that use cmdarg (safe help handler)
  if ! usesCmdarg "${file}"; then
    echo ""
    return
  fi

  timeout 2 "${file}" --help 2>&1 || true
}

# Parse cmdarg flags from script
parseCmdargFlags() {
  local file="$1"
  while IFS= read -r line; do
    local flag longopt descText
    # Extract values using sed with simple patterns
    flag=$(echo "${line}" | sed 's/.*cmdarg "\([^"]*\)".*/\1/' | head -1)
    longopt=$(echo "${line}" | sed 's/.*cmdarg "[^"]*" "\([^"]*\)".*/\1/' | head -1)
    descText=$(echo "${line}" | sed 's/.*cmdarg "[^"]*" "[^"]*" "\([^"]*\)".*/\1/' | head -1)

    if [[ -n "${flag}" ]]; then
      local flagType="String"
      if [[ "${flag}" != *":"* ]] && [[ "${flag}" != *"?"* ]]; then
        flagType="Boolean"
      elif [[ "${flag}" == *"[]"* ]]; then
        flagType="Array"
      elif [[ "${flag}" == *"{}"* ]]; then
        flagType="Hash Map"
      fi
      echo "| -${flag%%:*} | --${longopt} | ${flagType} | ${descText:-No description} |"
    fi
  done < <(grep -E '^\s*cmdarg\s+"' "${file}")
}

# Generate wiki page for a script
generateScriptPage() {
  local file="$1"
  local scriptName outputFile relDir
  scriptName=$(basename "${file}")

  # Determine relative directory
  local origRelDir
  origRelDir=$(dirname "${file}" | sed -e "s|^${SCRIPTS_DIR}||" -e " s|^/||")
  relDir="${origRelDir}"
  case "${relDir}" in
  "") relDir="bash" ;;
  # Bash scripts: lib -> bash/lib/, rofi -> bash/rofi/, external -> bash/external/
  lib | rofi | external) relDir="bash/${relDir}" ;;
  # Other languages keep their dir: wiki/c/, wiki/cpp/, etc.
  *) : ;;
  esac

  mkdir -p "${WIKI_DIR}/${relDir}"
  outputFile="${WIKI_DIR}/${relDir}/${scriptName}.md"

  if [[ -f "${outputFile}" ]] && ! "${FORCE}"; then
    logVerbose "Skipping ${scriptName} (exists, use -f to overwrite)"
    return 0
  fi

  logVerbose "Generating page for ${scriptName}..."

  local desc deps helpOutput
  desc="$(get-desc "${file}" | sed -e 's/  */ /g' -e 's/^ //' -e 's/ $//')"
  deps="$(get-deps "${file}")"
  helpOutput=$(getHelpOutput "${file}")

  {
    echo "# ${scriptName}"
    echo ""
    echo "## Description"
    echo ""
    if [[ -n "${desc}" ]]; then
      echo "${desc}"
    else
      echo "*No description available.*"
    fi
    echo ""
    echo "## Usage"
    echo ""
    echo '```bash'
    if [[ -n "${helpOutput}" ]]; then
      echo "${helpOutput}"
    else
      echo "${scriptName} [options] [arguments]"
    fi
    echo '```'
    echo ""

    # Document flags if script uses cmdarg
    if usesCmdarg "${file}"; then
      flagsTable=$(parseCmdargFlags "${file}")
      if [[ -n "${flagsTable}" ]]; then
        echo "## Flags & Options"
        echo ""
        echo "| Short | Long | Type | Description |"
        echo "|-------|------|------|-------------|"
        echo "${flagsTable}"
        echo ""
      fi
    fi

    # Positional arguments
    if grep -q 'argv\[' "${file}" || grep -q 'argc' "${file}"; then
      echo "## Positional Arguments"
      echo ""
      echo "This script accepts positional arguments after \`--\`."
      echo ""
    fi

    # Dependencies
    echo "## Dependencies"
    echo ""
    if [[ -z "${deps}" ]] || [[ "${deps}" == "x-none" ]]; then
      echo "No external dependencies."
    else
      echo "${deps}" | while IFS= read -r dep; do echo "- ${dep}"; done
    fi
    echo ""

    echo "## Source"
    echo ""
    local sourcePath="${origRelDir:+${origRelDir}/}${scriptName}"
    echo "[${scriptName}](${REPO_URL}/blob/main/${sourcePath})"
    echo ""

  } >"${outputFile}"

  log-success "Created: ${relDir}/${scriptName}.md"
}

# Generate wiki page for a library
generateLibPage() {
  local file="$1"
  local libName outputFile
  libName=$(basename "${file}" .sh)

  mkdir -p "${WIKI_DIR}/bash/lib"
  outputFile="${WIKI_DIR}/bash/lib/${libName}.md"

  if [[ -f "${outputFile}" ]] && ! "${FORCE}"; then
    logVerbose "Skipping lib/${libName} (exists, use -f to overwrite)"
    return 0
  fi

  logVerbose "Generating page for lib/${libName}..."

  local desc
  desc="$(get-desc "${file}" | sed -e 's/  */ /g' -e 's/^ //' -e' s/ $//')"

  {
    echo "# lib/${libName}"
    echo ""
    echo "## Description"
    echo ""
    if [[ -n "${desc}" ]]; then
      echo "${desc}"
    else
      echo "*No description available.*"
    fi
    echo ""
    echo "## Usage"
    echo ""
    echo "Include this library in your script:"
    echo ""
    echo '```bash'
    # shellcheck disable=SC2016
    echo 'source "$(include "lib/'"${libName}"'.sh")"'
    echo '```'
    echo ""
    echo "## Source"
    echo ""
    echo "[lib/${libName}.sh](${REPO_URL}/blob/main/lib/${libName}.sh)"
    echo ""
  } >"${outputFile}"

  log-success "Created: bash/lib/${libName}.md"
}

# --- Main --- #

mkdir -p "${WIKI_DIR}/bash"

# Process script files (called by parallel)
main() {
  local file
  # Reconstruct IGNORED_SCRIPTS array from serialized string
  local ignoredScripts=()
  while IFS= read -r ignoredScript; do
    ignoredScripts+=("${ignoredScript}")
  done <<< "${IGNORED_SCRIPTS_LIST}"

  for file in "$@"; do
    [[ -f "${file}" ]] || continue

    # Skip non-script files
    [[ "${file}" == *.rasi ]] && continue

    local firstLine
    firstLine=$(head -1 "${file}" 2>/dev/null || true)
    [[ "${firstLine}" == *"bash"* ]] || continue

    local scriptName
    scriptName=$(basename "${file}")

    # Skip ignored scripts
    local ignoredScript
    for ignoredScript in "${ignoredScripts[@]}"; do
      if [[ "${scriptName}" == "${ignoredScript}" ]]; then
        logVerbose "Skipping ${scriptName} (ignored)"
        continue 2
      fi
    done

    # Generate page based on file location
    if [[ "${file}" == *"/lib/"* ]]; then
      generateLibPage "${file}"
    else
      generateScriptPage "${file}"
    fi
  done
}

export -f main
export -f logVerbose
export -f generateScriptPage
export -f generateLibPage
export -f usesCmdarg
export -f getHelpOutput
export -f parseCmdargFlags
export WIKI_DIR FORCE VERBOSE SCRIPTS_DIR REPO_URL
# Bash cannot export arrays through the environment — serialize to a plain string
export IGNORED_SCRIPTS_LIST="$(printf '%s\n' "${IGNORED_SCRIPTS[@]}")"

printf '%s\0' "${SCRIPTS_DIR}"/* "${SCRIPTS_DIR}/lib"/*.sh "${SCRIPTS_DIR}/rofi"/* "${SCRIPTS_DIR}/external"/* | parallel -0 -j "${JOBS}" -k -m --tty main

# Generate Home.md
homeFile="${WIKI_DIR}/Home.md"
if [[ ! -f "${homeFile}" ]] || "${FORCE}"; then
  {
    echo "# Scripts Wiki"
    echo ""
    echo "Welcome to the Scripts Wiki. This wiki documents all bash scripts in the repository."
    echo ""
    echo "## Quick Links"
    echo ""
    echo "- [Libraries](#libraries)"
    echo "- [Scripts](#scripts)"
    echo ""
    echo "## Libraries"
    echo ""
    echo "| Library | Description |"
    echo "|---------|-------------|"
    # Libraries
    for file in "${SCRIPTS_DIR}/lib"/*.sh; do
      [[ -f "${file}" ]] || continue
      libName=$(basename "${file}" .sh)
      desc=$(get-desc "${file}" | tr '\n' ' ' | sed -e 's/  */ /g' -e 's/^ //' -e 's/ $//')
      echo "| [lib/${libName}](bash/lib/${libName}.md) | ${desc:-No description} |"
    done
    echo ""
    echo "## Scripts"
    echo ""
    echo "| Script | Description |"
    echo "|--------|-------------|"
    # Bash scripts from root
    for file in "${SCRIPTS_DIR}"/*; do
      [[ -f "${file}" ]] || continue
      firstLine=$(head -1 "${file}" 2>/dev/null || true)
      [[ "${firstLine}" == *"bash"* ]] || continue
      scriptName=$(basename "${file}")
      desc=$(get-desc "${file}" | tr '\n' ' ' | sed -e 's/  */ /g' -e 's/^ //' -e 's/ $//')
      echo "| [${scriptName}](bash/${scriptName}.md) | ${desc:-No description} |"
    done
    echo ""
  } >"${homeFile}"
  log-success "Created: Home.md"
fi

# Generate pages for non-bash scripts using LLM
if "${ALL}"; then
  document-with-llm -d "${WIKI_DIR}" -p "${PROVIDER}" ${MODEL:+-m "${MODEL}"} ${FORCE:+-f} ${VERBOSE:+-v}
fi

mdfmt "${WIKI_DIR}" &>/dev/null

echo ""
log-success "Wiki generation complete!"
echo "  Wiki location: ${WIKI_DIR}"
