#
#
# --- DESCRIPTION --- #
# Launch the rust book using vite
# --- DEPENDENCIES --- #
# - vite
# - rustup
# --- END SIGNATURE --- #

set -eo pipefail
trap 'exit 1' SIGUSR1

# shellcheck source=lib/cmdarg.sh
source "$(include "lib/cmdarg.sh")"
# shellcheck source=check-deps
source "$(include "check-deps")"

checkDeps "$0"
cmdarg_info "header" "$(get-desc "$0")"
cmdarg_parse "$@"
# ---  Main script logic --- #
cd "$(dirname "$(rustup doc --path)")/book" || log-error "Cannot find the Rust book"
vite --config "${XDG_CONFIG_HOME}/vite/vite.config.mjs" --port 9001 --open
